# Server-side Gemini credential. Never expose this as a VITE_* variable.
GEMINI_API_KEY=""

# Optional public app URL.
APP_URL=""

# Browser-side Google Maps configuration. Use a restricted browser key.
VITE_GOOGLE_MAPS_API_KEY=""

# Leave empty for the standard same-origin architecture.
# In development, Vite proxies /api to the local Express server.
# Only set this when intentionally using a separate backend service.
VITE_API_BASE_URL=""
